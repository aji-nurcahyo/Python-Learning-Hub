{
  "name": "python-learning-hub",
  "version": "2.1.0",
  "description": "Interactive Python Learning Modules — Learn Python, One Chapter at a Time",
  "author": "Aji Pamungkas Tri Nurcahyo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8932",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "gen:outputs": "python scripts/run_examples.py",
    "check:outputs": "node scripts/check_outputs.mjs",
    "check:resources": "node scripts/check_resources.mjs",
    "check:content": "node scripts/check_resources.mjs && node scripts/check_content.mjs",
    "check:presentations": "node scripts/check_presentations.mjs",
    "check:specializations": "node scripts/check_specializations.mjs",
    "test:routes": "node scripts/test_routes.mjs",
    "build": "npm run check:outputs && npm run check:content && npm run check:presentations && npm run check:specializations && npm run typecheck && vite build && npm run test:routes",
    "preview": "vite preview --host 127.0.0.1 --port 8932"
  },
  "dependencies": {
    "@fontsource-variable/google-sans-code": "^5.3.2",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "@fontsource-variable/material-symbols-rounded": "^5.3.9",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reveal.js": "^6.0.2",
    "shiki": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.3.5"
  }
}
